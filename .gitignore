# Source-only checkout: new paths are ignored unless deliberately allowed below.
*
!*/
!/.gitignore
!/.gitattributes
!/README.md
!/PUBLICATION.md
!/PUBLIC_SOURCE_MANIFEST.json
!/THIRD_PARTY_NOTICES.md
!/LICENSE
!/LICENSE.txt
!/LICENSE.ja.txt
!/INSTALL-NOTICE.en.txt
!/INSTALL-NOTICE.ja.txt
!/desktop.py
!/importer.py
!/server.py
!/tls.py
!/requirements.txt
!/requirements-onenote.txt
!/requirements-server.txt
!/twonote/*.py
!/windows/*.py
!/windows/*.ps1
!/windows/*.spec
!/windows/*.md
!/tools/*.py
!/tools/*.ps1
!/tests/**/*.py
!/tests/**/*.java
!/docs/*.md
!/android/README.md
!/android/build_android.ps1
!/android/build.gradle
!/android/settings.gradle
!/android/gradle.properties
!/android/app/build.gradle
!/android/app/src/**/*.java
!/android/app/src/**/*.xml

# Override the source rules for private/generated folders and settings.
**/__pycache__/
**/build/
**/.gradle/
**/.tools/
**/dist/
**/data/
**/onenoteexportdata/
**/archive/
**/web/
**/output/
**/github-public/
**/vault-v2*/
**/attachments/
**/.aws/
**/.ssh/
**/.idea/
**/.vscode/
**/local.properties
**/.env
**/.env.*
